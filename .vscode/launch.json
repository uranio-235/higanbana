{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Higanbana (Spring Boot)",
            "request": "launch",
            "mainClass": "local.higanbana.HiganbanaApplication",
            "cwd": "${workspaceFolder}",
            "vmArgs": "-Djavax.net.ssl.trustStoreType=Windows-ROOT -Djavax.net.ssl.trustStore=NONE",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "Attach to Higanbana (localhost:60316)",
            "request": "attach",
            "hostName": "localhost",
            "port": 60316
        }
    ]
}