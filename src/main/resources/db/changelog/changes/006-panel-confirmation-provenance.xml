<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">
    <changeSet id="006-panel-confirmation-provenance" author="higanbana">
        <addColumn tableName="panel_plan_confirmation">
            <column name="provenance" type="VARCHAR(255)"/>
        </addColumn>
        <sql>UPDATE panel_plan_confirmation SET provenance = (SELECT provenance FROM panel_plan WHERE panel_plan.id = panel_plan_confirmation.panel_plan_id) WHERE provenance IS NULL</sql>
    </changeSet>
</databaseChangeLog>