<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">
    <changeSet id="013-memory-entry" author="copilot">
        <createTable tableName="memory_entry">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="scope" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="content_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="CLOB">
                <constraints nullable="false"/>
            </column>
            <column name="embedding" type="CLOB">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="memory_entry" columnNames="scope, content_hash" constraintName="uq_memory_scope_hash"/>
        <createIndex tableName="memory_entry" indexName="idx_memory_scope">
            <column name="scope"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>